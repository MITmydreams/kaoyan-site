---
interface Props {
	kind: 'template' | 'essay';
	heading: string;
	titlePlaceholder: string;
	bodyPlaceholder: string;
}
const { kind, heading, titlePlaceholder, bodyPlaceholder } = Astro.props;
const addLabel = kind === 'template' ? '添加模板' : '添加范文';
---

<div class="gre-panel" data-gre="writing" data-kind={kind}>
	<div class="gre-panel-head">
		<h2 class="gre-inline-title">{heading}</h2>
		<button type="button" class="gre-btn gre-btn-primary gre-w-toggle-add">{addLabel}</button>
	</div>
	<p class="gre-hint">下方优先看已有内容。点卡片可编辑；新建时再点上方按钮。</p>

	<div class="gre-w-list">
		<p class="gre-muted">加载中…</p>
	</div>

	<div class="gre-composer gre-w-composer" hidden>
		<form class="gre-form gre-w-form">
			<input type="hidden" class="gre-w-edit-id" value="" />
			<label class="gre-grow">
				标题
				<input class="gre-w-title" type="text" placeholder={titlePlaceholder} required />
			</label>
			<label class="gre-grow gre-full">
				正文
				<textarea class="gre-w-body" rows="8" placeholder={bodyPlaceholder} required></textarea>
			</label>
			<div class="gre-form-actions">
				<button type="submit" class="gre-btn gre-btn-primary gre-w-submit">保存</button>
				<button type="button" class="gre-btn gre-w-cancel">收起</button>
			</div>
		</form>
	</div>
	<p class="gre-status gre-w-status" hidden></p>
</div>

<script>
	import {
		listWriting,
		addWriting,
		updateWriting,
		deleteWriting,
		getWritingById,
	} from '../../lib/gre-db';

	document.querySelectorAll('[data-gre="writing"]').forEach((root) => {
		const el = /** @type {HTMLElement} */ (root);
		if (el.dataset.bound) return;
		el.dataset.bound = '1';
		const kind = /** @type {'template'|'essay'} */ (el.dataset.kind);
		const addLabel = kind === 'template' ? '添加模板' : '添加范文';
		const composer = /** @type {HTMLElement} */ (el.querySelector('.gre-w-composer'));
		const form = /** @type {HTMLFormElement} */ (el.querySelector('.gre-w-form'));
		const editIdEl = /** @type {HTMLInputElement} */ (el.querySelector('.gre-w-edit-id'));
		const titleEl = /** @type {HTMLInputElement} */ (el.querySelector('.gre-w-title'));
		const bodyEl = /** @type {HTMLTextAreaElement} */ (el.querySelector('.gre-w-body'));
		const submitBtn = /** @type {HTMLButtonElement} */ (el.querySelector('.gre-w-submit'));
		const cancelBtn = /** @type {HTMLButtonElement} */ (el.querySelector('.gre-w-cancel'));
		const toggleAddBtn = /** @type {HTMLButtonElement} */ (el.querySelector('.gre-w-toggle-add'));
		const statusEl = /** @type {HTMLElement} */ (el.querySelector('.gre-w-status'));
		const listEl = /** @type {HTMLElement} */ (el.querySelector('.gre-w-list'));

		function escapeHtml(s) {
			return s
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		function setStatus(msg, ok = true) {
			statusEl.hidden = !msg;
			statusEl.textContent = msg;
			statusEl.classList.toggle('is-error', !ok);
		}

		function setComposerOpen(open) {
			composer.hidden = !open;
			toggleAddBtn.textContent = open ? '收起表单' : addLabel;
		}

		function setEditing(id) {
			editIdEl.value = id || '';
			const editing = Boolean(id);
			submitBtn.textContent = editing ? '更新' : '保存';
			cancelBtn.textContent = editing ? '取消编辑' : '收起';
		}

		function clearForm() {
			setEditing('');
			titleEl.value = '';
			bodyEl.value = '';
		}

		function openForCreate() {
			clearForm();
			setComposerOpen(true);
			titleEl.focus();
			composer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		function collapseComposer() {
			clearForm();
			setComposerOpen(false);
			setStatus('');
		}

		async function refresh() {
			const rows = await listWriting(kind);
			if (!rows.length) {
				listEl.innerHTML = `<p class="gre-muted">暂无条目。点上方「${escapeHtml(addLabel)}」写一条。</p>`;
				return;
			}
			listEl.innerHTML = rows
				.map(
					(r) => `
				<article class="gre-card gre-card-editable" data-id="${r.id}" title="点击编辑">
					<header>
						<strong>${escapeHtml(r.title)}</strong>
						<button type="button" class="gre-mini-btn" data-edit="${r.id}">编辑</button>
						<button type="button" class="gre-mini-btn" data-del="${r.id}">删除</button>
					</header>
					<pre class="gre-pre">${escapeHtml(r.body)}</pre>
					<p class="gre-meta">${escapeHtml((r.updatedAt || r.createdAt).replace('T', ' ').slice(0, 16))}</p>
				</article>`,
				)
				.join('');
		}

		async function beginEdit(id) {
			const row = await getWritingById(id);
			if (!row) return;
			setEditing(id);
			titleEl.value = row.title;
			bodyEl.value = row.body;
			setComposerOpen(true);
			titleEl.focus();
			composer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			setStatus(`正在编辑：${row.title}`);
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			try {
				const payload = { title: titleEl.value, body: bodyEl.value };
				const wasEdit = Boolean(editIdEl.value);
				if (wasEdit) await updateWriting(editIdEl.value, payload);
				else await addWriting({ kind, ...payload });
				collapseComposer();
				setStatus(wasEdit ? `已更新：${payload.title.trim()}` : `已保存：${payload.title.trim()}`);
				await refresh();
			} catch (err) {
				setStatus(err instanceof Error ? err.message : String(err), false);
			}
		});

		toggleAddBtn.addEventListener('click', () => {
			if (composer.hidden) openForCreate();
			else collapseComposer();
		});

		cancelBtn.addEventListener('click', () => collapseComposer());

		listEl.addEventListener('click', async (e) => {
			const t = /** @type {HTMLElement} */ (e.target);
			const del = t.getAttribute('data-del');
			if (del) {
				e.stopPropagation();
				if (!confirm('删除？')) return;
				await deleteWriting(del);
				if (editIdEl.value === del) collapseComposer();
				await refresh();
				return;
			}
			const edit = t.getAttribute('data-edit') || t.closest('.gre-card-editable')?.getAttribute('data-id');
			if (edit) await beginEdit(edit);
		});

		window.addEventListener('gre:cloud-updated', () => {
			refresh().catch((err) => setStatus(String(err), false));
		});
		refresh().catch((err) => setStatus(String(err), false));
	});
</script>
