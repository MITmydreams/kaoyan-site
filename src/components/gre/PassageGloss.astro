---
/** GRE Verbal · 题目/难句：列表优先，表单默认收起 */
---

<div class="gre-panel" id="gre-passage-root" data-gre="passage">
	<div class="gre-panel-head">
		<h2 class="gre-inline-title">题目 / 难句</h2>
		<button type="button" class="gre-btn gre-btn-primary" id="gre-passage-toggle-add">添加条目</button>
	</div>
	<p class="gre-hint">下方优先看已有内容。点词看释义；点「编辑」或「添加条目」再展开表单。</p>

	<div id="gre-passage-list" class="gre-passage-list">
		<p class="gre-muted">加载中…</p>
	</div>

	<div class="gre-composer" id="gre-passage-composer" hidden>
		<form class="gre-form" id="gre-passage-form">
			<input type="hidden" id="gre-passage-edit-id" value="" />
			<label>
				类型
				<select id="gre-passage-kind">
					<option value="question">错题</option>
					<option value="sentence">难句</option>
					<option value="passage">文章片段</option>
				</select>
			</label>
			<label class="gre-grow">
				标题
				<input id="gre-passage-title" type="text" placeholder="来源 / 题号 / 一句话备注" />
			</label>
			<label class="gre-grow gre-full">
				正文（英文）
				<textarea id="gre-passage-body" rows="5" placeholder="粘贴题目、句子或段落…" required></textarea>
			</label>
			<div class="gre-form-actions">
				<button type="submit" class="gre-btn gre-btn-primary" id="gre-passage-submit">存入题目页</button>
				<button type="button" class="gre-btn" id="gre-passage-cancel">收起</button>
			</div>
		</form>
	</div>
	<p class="gre-status" id="gre-passage-status" hidden></p>

	<dialog class="gre-dialog" id="gre-gloss-dialog">
		<div class="gre-dialog-inner" id="gre-gloss-form">
			<header class="gre-dialog-head">
				<strong id="gre-dialog-word"></strong>
				<button type="button" class="gre-mini-btn" id="gre-dialog-close">关闭</button>
			</header>
			<div id="gre-dialog-known" hidden>
				<p class="gre-gloss" id="gre-dialog-gloss"></p>
				<p class="gre-note" id="gre-dialog-note"></p>
				<a id="gre-dialog-ldoce-known" class="gre-mini-link" href="#" target="_blank" rel="noopener noreferrer">在 LDOCE 打开</a>
			</div>
			<div id="gre-dialog-missing" hidden>
				<p class="gre-warn">词库里还没有这个词。可以先关掉；想记的时候再查 LDOCE 把释义贴回来。</p>
				<a id="gre-dialog-ldoce-missing" class="gre-btn gre-btn-primary" href="#" target="_blank" rel="noopener noreferrer">打开 Longman 查这个词</a>
				<label class="gre-grow gre-full">
					释义（可选，要存进词库时再填）
					<textarea id="gre-dialog-new-gloss" rows="3" placeholder="暂时不填也可以直接关闭"></textarea>
				</label>
				<label class="gre-grow gre-full">
					备注（可选）
					<input id="gre-dialog-new-note" type="text" />
				</label>
				<button type="button" class="gre-btn gre-btn-primary" id="gre-dialog-save">存入词库并显示</button>
			</div>
		</div>
	</dialog>
</div>

<script>
	import {
		listPassages,
		addPassage,
		updatePassage,
		deletePassage,
		getPassageById,
		getWordByLemma,
		upsertWord,
		ldoceUrl,
		tokenizeForGloss,
		normalizeWord,
	} from '../../lib/gre-db';

	const root = document.getElementById('gre-passage-root');
	if (root && !root.dataset.bound) {
		root.dataset.bound = '1';

		const composer = /** @type {HTMLElement} */ (document.getElementById('gre-passage-composer'));
		const form = /** @type {HTMLFormElement} */ (document.getElementById('gre-passage-form'));
		const editIdEl = /** @type {HTMLInputElement} */ (document.getElementById('gre-passage-edit-id'));
		const kindEl = /** @type {HTMLSelectElement} */ (document.getElementById('gre-passage-kind'));
		const titleEl = /** @type {HTMLInputElement} */ (document.getElementById('gre-passage-title'));
		const bodyEl = /** @type {HTMLTextAreaElement} */ (document.getElementById('gre-passage-body'));
		const submitBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-passage-submit'));
		const cancelBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-passage-cancel'));
		const toggleAddBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-passage-toggle-add'));
		const statusEl = /** @type {HTMLElement} */ (document.getElementById('gre-passage-status'));
		const listEl = /** @type {HTMLElement} */ (document.getElementById('gre-passage-list'));
		const dialog = /** @type {HTMLDialogElement} */ (document.getElementById('gre-gloss-dialog'));
		const dialogWord = /** @type {HTMLElement} */ (document.getElementById('gre-dialog-word'));
		const knownBox = /** @type {HTMLElement} */ (document.getElementById('gre-dialog-known'));
		const missingBox = /** @type {HTMLElement} */ (document.getElementById('gre-dialog-missing'));
		const glossEl = /** @type {HTMLElement} */ (document.getElementById('gre-dialog-gloss'));
		const noteEl = /** @type {HTMLElement} */ (document.getElementById('gre-dialog-note'));
		const ldoceKnown = /** @type {HTMLAnchorElement} */ (document.getElementById('gre-dialog-ldoce-known'));
		const ldoceMissing = /** @type {HTMLAnchorElement} */ (document.getElementById('gre-dialog-ldoce-missing'));
		const newGloss = /** @type {HTMLTextAreaElement} */ (document.getElementById('gre-dialog-new-gloss'));
		const newNote = /** @type {HTMLInputElement} */ (document.getElementById('gre-dialog-new-note'));
		const saveBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-dialog-save'));
		const closeBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-dialog-close'));

		/** @type {string} */
		let pendingWord = '';

		const kindLabel = { question: '错题', sentence: '难句', passage: '文章' };

		function setStatus(msg, ok = true) {
			statusEl.hidden = !msg;
			statusEl.textContent = msg;
			statusEl.classList.toggle('is-error', !ok);
		}

		function setComposerOpen(open) {
			composer.hidden = !open;
			toggleAddBtn.textContent = open ? '收起表单' : '添加条目';
		}

		function setEditing(id) {
			editIdEl.value = id || '';
			const editing = Boolean(id);
			submitBtn.textContent = editing ? '更新' : '存入题目页';
			cancelBtn.textContent = editing ? '取消编辑' : '收起';
		}

		function clearForm() {
			setEditing('');
			kindEl.value = 'question';
			titleEl.value = '';
			bodyEl.value = '';
		}

		function openForCreate() {
			clearForm();
			setComposerOpen(true);
			titleEl.focus();
			composer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		function collapseComposer() {
			clearForm();
			setComposerOpen(false);
			setStatus('');
		}

		function escapeHtml(s) {
			return s
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		function renderPassageHtml(body) {
			return tokenizeForGloss(body)
				.map((tok) =>
					tok.type === 'word'
						? `<button type="button" class="gre-token" data-word="${escapeHtml(tok.value)}">${escapeHtml(tok.value)}</button>`
						: `<span>${escapeHtml(tok.value)}</span>`,
				)
				.join('');
		}

		async function refresh() {
			const rows = await listPassages();
			if (!rows.length) {
				listEl.innerHTML = `<p class="gre-muted">还没有条目。点上方「添加条目」贴错题或难句。</p>`;
				return;
			}
			listEl.innerHTML = rows
				.map(
					(p) => `
				<article class="gre-card gre-passage-card" data-id="${p.id}">
					<header>
						<span class="gre-badge">${kindLabel[p.kind] || p.kind}</span>
						<strong>${escapeHtml(p.title)}</strong>
						<button type="button" class="gre-mini-btn" data-edit="${p.id}">编辑</button>
						<button type="button" class="gre-mini-btn" data-del="${p.id}">删除</button>
					</header>
					<div class="gre-passage-body">${renderPassageHtml(p.body)}</div>
					<p class="gre-meta">${escapeHtml((p.updatedAt || p.createdAt).replace('T', ' ').slice(0, 16))}</p>
				</article>`,
				)
				.join('');
		}

		async function beginEdit(id) {
			const row = await getPassageById(id);
			if (!row) return;
			setEditing(id);
			kindEl.value = row.kind;
			titleEl.value = row.title;
			bodyEl.value = row.body;
			setComposerOpen(true);
			titleEl.focus();
			composer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
			setStatus(`正在编辑：${row.title}`);
		}

		async function openWord(raw) {
			pendingWord = normalizeWord(raw);
			dialogWord.textContent = pendingWord;
			ldoceKnown.href = ldoceUrl(pendingWord);
			ldoceMissing.href = ldoceUrl(pendingWord);
			newGloss.value = '';
			newNote.value = '';

			const hit = await getWordByLemma(pendingWord);
			if (hit) {
				knownBox.hidden = false;
				missingBox.hidden = true;
				glossEl.textContent = hit.gloss;
				noteEl.textContent = hit.note || '';
				noteEl.hidden = !hit.note;
			} else {
				knownBox.hidden = true;
				missingBox.hidden = false;
			}
			dialog.showModal();
		}

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			try {
				const payload = {
					title: titleEl.value,
					body: bodyEl.value,
					kind: /** @type {'question'|'sentence'|'passage'} */ (kindEl.value),
				};
				const wasEdit = Boolean(editIdEl.value);
				if (wasEdit) await updatePassage(editIdEl.value, payload);
				else await addPassage(payload);
				collapseComposer();
				setStatus(wasEdit ? '已更新' : '已保存');
				await refresh();
			} catch (err) {
				setStatus(err instanceof Error ? err.message : String(err), false);
			}
		});

		toggleAddBtn.addEventListener('click', () => {
			if (composer.hidden) openForCreate();
			else collapseComposer();
		});
		cancelBtn.addEventListener('click', () => collapseComposer());

		listEl.addEventListener('click', async (e) => {
			const t = /** @type {HTMLElement} */ (e.target);
			const del = t.getAttribute('data-del');
			if (del) {
				if (!confirm('删除这条？')) return;
				await deletePassage(del);
				if (editIdEl.value === del) collapseComposer();
				await refresh();
				return;
			}
			const edit = t.getAttribute('data-edit');
			if (edit) {
				await beginEdit(edit);
				return;
			}
			const word = t.getAttribute('data-word');
			if (word) await openWord(word);
		});

		closeBtn.addEventListener('click', () => dialog.close());
		dialog.addEventListener('click', (e) => {
			if (e.target === dialog) dialog.close();
		});

		saveBtn.addEventListener('click', async () => {
			try {
				const row = await upsertWord({
					word: pendingWord,
					gloss: newGloss.value,
					note: newNote.value,
				});
				knownBox.hidden = false;
				missingBox.hidden = true;
				glossEl.textContent = row.gloss;
				noteEl.textContent = row.note || '';
				noteEl.hidden = !row.note;
				setStatus(`已把「${pendingWord}」写入词库`);
			} catch (err) {
				setStatus(err instanceof Error ? err.message : String(err), false);
			}
		});

		window.addEventListener('gre:cloud-updated', () => {
			refresh().catch((err) => setStatus(String(err), false));
		});
		refresh().catch((err) => setStatus(String(err), false));
	}
</script>
