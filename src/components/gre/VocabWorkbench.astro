---
/** GRE Verbal · 添加词汇：列表优先；释义+例句成对，可多组 */
import { withBase } from '../../lib/with-base';
const overviewHref = withBase('gre/verbal/vocab-overview/');
---

<div class="gre-panel" id="gre-vocab-root" data-gre="vocab" data-overview-href={overviewHref}>
	<div class="gre-panel-head">
		<h2 class="gre-inline-title">词汇</h2>
		<button type="button" class="gre-btn gre-btn-primary" id="gre-vocab-toggle-add">添加词汇</button>
	</div>
	<div class="gre-toolbar">
		<a class="gre-btn" id="gre-ldoce-link" href="https://www.ldoceonline.com/dictionary/" target="_blank" rel="noopener noreferrer">
			打开 Longman 查词
		</a>
		<a class="gre-btn" href={overviewHref}>打开词汇总览</a>
		<button type="button" class="gre-btn" id="gre-export-btn">导出备份 JSON</button>
	</div>
	<p class="gre-hint">每词至少一组「释义 + 例句」；可点「再加一组」。浏览 / 改内容用总览表。</p>

	<div id="gre-vocab-recent" class="gre-vocab-recent">
		<h3 class="gre-inline-title">最近存入</h3>
		<p class="gre-muted" id="gre-vocab-recent-body">加载中…</p>
	</div>

	<div class="gre-composer" id="gre-vocab-composer" hidden>
		<form class="gre-form" id="gre-vocab-form">
			<label>
				单词
				<input id="gre-word-input" type="text" placeholder="e.g. ephemeral" autocomplete="off" required />
			</label>
			<div class="gre-grow gre-full gre-senses" id="gre-vocab-senses"></div>
			<div class="gre-form-actions gre-full">
				<button type="button" class="gre-btn" id="gre-vocab-add-sense">再加一组释义</button>
			</div>
			<label class="gre-grow">
				备注（可选）
				<input id="gre-note-input" type="text" placeholder="语境 / 易混 / 来源题号…" />
			</label>
			<div class="gre-form-actions">
				<button type="submit" class="gre-btn gre-btn-primary" id="gre-vocab-submit">存入词库</button>
				<button type="button" class="gre-btn" id="gre-vocab-cancel">收起</button>
			</div>
		</form>
	</div>
	<p class="gre-status" id="gre-vocab-status" hidden></p>
</div>

<script>
	import {
		listWords,
		upsertWord,
		ldoceUrl,
		exportGreJson,
	} from '../../lib/gre-db';

	const root = document.getElementById('gre-vocab-root');
	if (root && !root.dataset.bound) {
		root.dataset.bound = '1';
		const overviewHref = root.dataset.overviewHref || '/gre/verbal/vocab-overview/';

		const composer = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-composer'));
		const form = /** @type {HTMLFormElement} */ (document.getElementById('gre-vocab-form'));
		const wordInput = /** @type {HTMLInputElement} */ (document.getElementById('gre-word-input'));
		const sensesBox = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-senses'));
		const noteInput = /** @type {HTMLInputElement} */ (document.getElementById('gre-note-input'));
		const statusEl = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-status'));
		const recentBody = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-recent-body'));
		const ldoceLink = /** @type {HTMLAnchorElement} */ (document.getElementById('gre-ldoce-link'));
		const exportBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-export-btn'));
		const toggleAddBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-vocab-toggle-add'));
		const cancelBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-vocab-cancel'));
		const addSenseBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-vocab-add-sense'));

		function setStatus(msg, ok = true) {
			statusEl.hidden = !msg;
			statusEl.textContent = msg;
			statusEl.classList.toggle('is-error', !ok);
		}

		function escapeHtml(s) {
			return s
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		function senseRowHtml(gloss = '', example = '', canRemove = false) {
			return `<div class="gre-sense-row">
				<label class="gre-sense-field">释义
					<textarea class="gre-sense-gloss" rows="2" placeholder="释义…" required>${escapeHtml(gloss)}</textarea>
				</label>
				<label class="gre-sense-field">例句
					<textarea class="gre-sense-example" rows="2" placeholder="含该词的英文例句…" required>${escapeHtml(example)}</textarea>
				</label>
				${canRemove ? '<button type="button" class="gre-mini-btn gre-sense-remove">删除这组</button>' : ''}
			</div>`;
		}

		function renderSenses(pairs = [{ gloss: '', example: '' }]) {
			const list = pairs.length ? pairs : [{ gloss: '', example: '' }];
			sensesBox.innerHTML = list
				.map((s, i) => senseRowHtml(s.gloss, s.example, list.length > 1))
				.join('');
		}

		function readSenses() {
			return [...sensesBox.querySelectorAll('.gre-sense-row')].map((row) => ({
				gloss: /** @type {HTMLTextAreaElement} */ (row.querySelector('.gre-sense-gloss')).value,
				example: /** @type {HTMLTextAreaElement} */ (row.querySelector('.gre-sense-example')).value,
			}));
		}

		function setComposerOpen(open) {
			composer.hidden = !open;
			toggleAddBtn.textContent = open ? '收起表单' : '添加词汇';
		}

		function openForCreate() {
			noteInput.value = '';
			renderSenses([{ gloss: '', example: '' }]);
			setComposerOpen(true);
			wordInput.focus();
			composer.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
		}

		function collapseComposer() {
			setComposerOpen(false);
		}

		function syncLdoce() {
			ldoceLink.href = ldoceUrl(wordInput.value);
		}

		function formatSensesPreview(w) {
			const senses = w.senses?.length ? w.senses : [{ gloss: w.gloss, example: '' }];
			return senses
				.map((s) => {
					const g = escapeHtml((s.gloss || '').slice(0, 60)) + ((s.gloss || '').length > 60 ? '…' : '');
					const ex = s.example
						? ` <em class="gre-sense-ex">e.g. ${escapeHtml(s.example.slice(0, 50))}${
								s.example.length > 50 ? '…' : ''
							}</em>`
						: '';
					return `${g}${ex}`;
				})
				.join(' · ');
		}

		async function refreshRecent() {
			const words = await listWords();
			const recent = words.slice(0, 8);
			if (!recent.length) {
				recentBody.innerHTML = `还没有词。点「添加词汇」，或去 <a href="${overviewHref}">总览</a>。`;
				return;
			}
			recentBody.innerHTML =
				`<ul class="gre-recent-list">` +
				recent.map((w) => `<li><strong>${escapeHtml(w.word)}</strong> — ${formatSensesPreview(w)}</li>`).join('') +
				`</ul><p class="gre-muted"><a href="${overviewHref}">在总览表中查看全部 ${words.length} 词 →</a></p>`;
		}

		wordInput.addEventListener('input', syncLdoce);

		toggleAddBtn.addEventListener('click', () => {
			if (composer.hidden) openForCreate();
			else collapseComposer();
		});
		cancelBtn.addEventListener('click', () => collapseComposer());

		addSenseBtn.addEventListener('click', () => {
			const cur = readSenses();
			cur.push({ gloss: '', example: '' });
			renderSenses(cur);
		});

		sensesBox.addEventListener('click', (e) => {
			const t = /** @type {HTMLElement} */ (e.target);
			if (!t.classList.contains('gre-sense-remove')) return;
			const rows = readSenses();
			const idx = [...sensesBox.querySelectorAll('.gre-sense-row')].indexOf(
				/** @type {HTMLElement} */ (t.closest('.gre-sense-row')),
			);
			if (idx >= 0 && rows.length > 1) {
				rows.splice(idx, 1);
				renderSenses(rows);
			}
		});

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			try {
				const saved = wordInput.value.trim();
				await upsertWord({
					word: wordInput.value,
					senses: readSenses(),
					note: noteInput.value,
				});
				collapseComposer();
				setStatus(`已保存：${saved}（可在总览里搜索修改）`);
				wordInput.value = '';
				noteInput.value = '';
				renderSenses([{ gloss: '', example: '' }]);
				syncLdoce();
				await refreshRecent();
			} catch (err) {
				setStatus(err instanceof Error ? err.message : String(err), false);
			}
		});

		exportBtn.addEventListener('click', async () => {
			const json = await exportGreJson();
			const blob = new Blob([json], { type: 'application/json' });
			const a = document.createElement('a');
			a.href = URL.createObjectURL(blob);
			a.download = `gre-backup-${new Date().toISOString().slice(0, 10)}.json`;
			a.click();
			URL.revokeObjectURL(a.href);
		});

		renderSenses([{ gloss: '', example: '' }]);
		syncLdoce();
		window.addEventListener('gre:cloud-updated', () => {
			refreshRecent().catch((err) => setStatus(String(err), false));
		});
		refreshRecent().catch((err) => setStatus(String(err), false));
	}
</script>
