---
/** GRE Verbal · 添加词汇：LDOCE 查词 → 存入本机词库 */
const base = import.meta.env.BASE_URL;
---

<div class="gre-panel" id="gre-vocab-root" data-gre="vocab" data-base={base}>
	<div class="gre-toolbar">
		<a class="gre-btn gre-btn-primary" id="gre-ldoce-link" href="https://www.ldoceonline.com/dictionary/" target="_blank" rel="noopener noreferrer">
			打开 Longman 查词
		</a>
		<a class="gre-btn" href={`${base}gre/verbal/vocab-overview/`}>打开词汇总览</a>
		<button type="button" class="gre-btn" id="gre-export-btn">导出备份 JSON</button>
		<span class="gre-hint">本页专注「查词 → 存入」（需先解锁）。浏览 / 搜索 / 改释义请用总览表。</span>
	</div>

	<form class="gre-form" id="gre-vocab-form">
		<label>
			单词
			<input id="gre-word-input" type="text" placeholder="e.g. ephemeral" autocomplete="off" required />
		</label>
		<label class="gre-grow">
			我想记住的释义
			<textarea id="gre-gloss-input" rows="3" placeholder="从 LDOCE 粘贴你要记的那一两句…" required></textarea>
		</label>
		<label class="gre-grow">
			备注（可选）
			<input id="gre-note-input" type="text" placeholder="语境 / 易混 / 来源题号…" />
		</label>
		<button type="submit" class="gre-btn gre-btn-primary" id="gre-vocab-submit">存入词库</button>
	</form>
	<p class="gre-status" id="gre-vocab-status" hidden></p>

	<div id="gre-vocab-recent" class="gre-vocab-recent">
		<h3 class="gre-inline-title">最近存入</h3>
		<p class="gre-muted" id="gre-vocab-recent-body">加载中…</p>
	</div>
</div>

<script>
	import {
		listWords,
		upsertWord,
		ldoceUrl,
		exportGreJson,
	} from '../../lib/gre-db';

	const root = document.getElementById('gre-vocab-root');
	if (root && !root.dataset.bound) {
		root.dataset.bound = '1';
		const base = root.dataset.base || '/';

		const form = /** @type {HTMLFormElement} */ (document.getElementById('gre-vocab-form'));
		const wordInput = /** @type {HTMLInputElement} */ (document.getElementById('gre-word-input'));
		const glossInput = /** @type {HTMLTextAreaElement} */ (document.getElementById('gre-gloss-input'));
		const noteInput = /** @type {HTMLInputElement} */ (document.getElementById('gre-note-input'));
		const statusEl = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-status'));
		const recentBody = /** @type {HTMLElement} */ (document.getElementById('gre-vocab-recent-body'));
		const ldoceLink = /** @type {HTMLAnchorElement} */ (document.getElementById('gre-ldoce-link'));
		const exportBtn = /** @type {HTMLButtonElement} */ (document.getElementById('gre-export-btn'));

		function setStatus(msg, ok = true) {
			statusEl.hidden = !msg;
			statusEl.textContent = msg;
			statusEl.classList.toggle('is-error', !ok);
		}

		function escapeHtml(s) {
			return s
				.replaceAll('&', '&amp;')
				.replaceAll('<', '&lt;')
				.replaceAll('>', '&gt;')
				.replaceAll('"', '&quot;');
		}

		function syncLdoce() {
			ldoceLink.href = ldoceUrl(wordInput.value);
		}

		async function refreshRecent() {
			const words = await listWords();
			const recent = words.slice(0, 8);
			const overviewHref = `${base}gre/verbal/vocab-overview/`;
			if (!recent.length) {
				recentBody.innerHTML = `还没有词。<a href="${overviewHref}">总览</a>也是空的。`;
				return;
			}
			recentBody.innerHTML =
				`<ul class="gre-recent-list">` +
				recent
					.map(
						(w) =>
							`<li><strong>${escapeHtml(w.word)}</strong> — ${escapeHtml(w.gloss.slice(0, 80))}${
								w.gloss.length > 80 ? '…' : ''
							}</li>`,
					)
					.join('') +
				`</ul><p class="gre-muted"><a href="${overviewHref}">在总览表中查看全部 ${words.length} 词 →</a></p>`;
		}

		wordInput.addEventListener('input', syncLdoce);

		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			try {
				await upsertWord({
					word: wordInput.value,
					gloss: glossInput.value,
					note: noteInput.value,
				});
				setStatus(`已保存：${wordInput.value.trim()}（可在总览里搜索修改）`);
				glossInput.value = '';
				noteInput.value = '';
				wordInput.focus();
				await refreshRecent();
			} catch (err) {
				setStatus(err instanceof Error ? err.message : String(err), false);
			}
		});

		exportBtn.addEventListener('click', async () => {
			const json = await exportGreJson();
			const blob = new Blob([json], { type: 'application/json' });
			const a = document.createElement('a');
			a.href = URL.createObjectURL(blob);
			a.download = `gre-backup-${new Date().toISOString().slice(0, 10)}.json`;
			a.click();
			URL.revokeObjectURL(a.href);
		});

		syncLdoce();
		window.addEventListener('gre:cloud-updated', () => {
			refreshRecent().catch((err) => setStatus(String(err), false));
		});
		refreshRecent().catch((err) => setStatus(String(err), false));
	}
</script>
